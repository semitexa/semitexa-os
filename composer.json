{
    "name": "semitexa/os",
    "description": "Semitexa OS \u2014 intent-first environment shell: the Intent\u2192Plan\u2192Execute\u2192Observe loop over Skills, generalised beyond the terminal",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.09.17.1037 || dev-master",
        "semitexa/auth": "*",
        "semitexa/authorization": "*",
        "semitexa/platform-user": "*",
        "semitexa/llm": "*",
        "semitexa/prompt": ">=2026.09.16.0602 || dev-master",
        "semitexa/locale": "*",
        "semitexa/ssr": ">=2026.10.14.0919 || dev-master",
        "semitexa/orm": "*",
        "semitexa/platform-settings": "*",
        "semitexa/platform-ui": ">=2026.10.08.0620 || dev-master",
        "semitexa/theme": "*",
        "semitexa/weave": "*",
        "semitexa/update": "*"
    },
    "suggest": {
        "semitexa/webapps": "Registered web apps (YouTube and the like) open as OS dialogs, and a Chill chip can be pointed at one. Not a require: semitexa/webapps requires this package."
    },
    "require-dev": {
        "semitexa/cms": "*",
        "phpunit/phpunit": "^10.0",
        "semitexa/testing": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Os\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Os\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "name": "os",
            "description": "Semitexa OS shell \u2014 intent-first Skill loop over the web channel",
            "template_alias": "project-layouts-Os"
        },
        "semitexa": {
            "floors": {
                "semitexa/orm": "next",
                "semitexa/platform-ui": "2026.10.08.0620",
                "semitexa/platform-user": "next",
                "semitexa/core": "next",
                "semitexa/llm": "next",
                "semitexa/ssr": "2026.10.14.0919"
            }
        }
    },
    "keywords": [
        "semitexa",
        "os",
        "intent",
        "skills",
        "assistant",
        "shell"
    ]
}
