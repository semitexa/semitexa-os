{
    "name": "semitexa/os",
    "description": "Semitexa OS — intent-first environment shell: the Intent→Plan→Execute→Observe loop over Skills, generalised beyond the terminal",
    "type": "semitexa-module",
    "license": "MIT",
    "authors": [
        {
            "name": "Semitexa",
            "email": "support@semitexa.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "semitexa/core": ">=2026.09.17.1037 || dev-master",
        "semitexa/auth": "*",
        "semitexa/authorization": "*",
        "semitexa/platform-user": "*",
        "semitexa/llm": "*",
        "semitexa/prompt": ">=2026.09.16.0602 || dev-master",
        "semitexa/locale": "*",
        "semitexa/ssr": "*",
        "semitexa/orm": "*",
        "semitexa/platform-settings": "*",
        "semitexa/platform-ui": "*",
        "semitexa/theme": "*",
        "semitexa/weave": "*",
        "semitexa/update": "*"
    },
    "require-dev": {
        "semitexa/cms": "*",
        "phpunit/phpunit": "^10.0",
        "semitexa/testing": "*"
    },
    "autoload": {
        "psr-4": {
            "Semitexa\\Os\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Semitexa\\Os\\Tests\\": "tests/"
        }
    },
    "extra": {
        "semitexa-module": {
            "name": "os",
            "description": "Semitexa OS shell — intent-first Skill loop over the web channel",
            "template_alias": "project-layouts-Os"
        }
    },
    "keywords": [
        "semitexa",
        "os",
        "intent",
        "skills",
        "assistant",
        "shell"
    ]
}
