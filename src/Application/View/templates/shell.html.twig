<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Semitexa OS</title>
    <link rel="stylesheet" href="{{ asset('semitexa-os-shell/tokens.css', 'skins') }}">
    <link rel="stylesheet" href="{{ asset('css/design-extras.css', 'os') }}">
    <link rel="stylesheet" href="{{ asset('css/shell.css', 'os') }}">
    <script src="{{ asset('js/vendor/lucide.min.js', 'os') }}"></script>
    <script src="{{ asset('js/vendor/force-graph.min.js', 'os') }}"></script>
    {# The page's live channel: the KISS session the process feed rides, and the
       import map event-runtime needs to import platform-ui/core by name. Not
       asset_head(): the shell writes its own head. #}
    {{ ui_page_sse_session_meta('live') }}
    {{ asset_import_map() }}
</head>
<body>
    <div class="os-root" id="root"></div>
    <div id="wm-layer" hidden></div>
    <div id="weave-layer" hidden></div>

    <script type="application/json" id="os-boot">{{ { providerName: providerName|default('llm'), providerModel: providerModel|default('?'), providerHealthy: providerHealthy, providerLocal: providerLocal|default(false), skills: skills|default([]), assistantName: assistantName|default('Solomiia'), userName: userName|default(''), windowMode: windowMode|default('web'), bridgeUrl: bridgeUrl|default('http://127.0.0.1:8777'), locale: locale|default('en'), strings: strings|default({}), inputLayouts: inputLayouts|default(null), features: features|default({}) }|json_encode|raw }}</script>
    {# ui-core is an ESM+IIFE dual: as a module it populates window.SemitexaUi.core
       (openFeedChannel); event-runtime owns window.SemitexaUi.sse, the page's one
       KISS stream openFeedChannel subscribes on through HUG. Without it every
       feed fell back to polling. Module scripts and the deferred shell.js run in
       document order, so both land first; shell.js still guards the globals and
       polls when they are absent. #}
    <script type="module" src="{{ asset('js/ui-core.js', 'platform-ui') }}"></script>
    <script type="module" src="{{ asset('js/event-runtime.js', 'platform-ui') }}"></script>
    <script src="{{ asset('js/shell.js', 'os') }}" defer></script>
</body>
</html>
